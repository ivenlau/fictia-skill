#!/usr/bin/env python3
"""
Fictia CLI 主入口。

子命令：
  init <name>             新建项目（创建目录、project.yaml、占位文件）
  status                  渲染状态面板
  stage                   下一个可执行阶段
  stage <sub> <stage>     ready / confirm / invalidate / start / fail
  words <file>...         统计字数
  judge <actual> <target> 字数判定
  milestone               检查章节里程碑
  consistency confirm     记录一致性校验通过的章节
  source import <file>     导入改写/仿写/续写源文本（epub/txt/md）
  ctx <program> [...]     上下文压缩与组装（8 个程序 + 3 个 assemble）
  verdict review <file>   解析编辑审核报告
  verdict consistency <file> 解析一致性校验报告
  export <md|txt>         导出整本小说
  lint                    项目结构校验
  notes <sub> [...]       用户笔记管理（add/list/show/link/revert）
"""

from __future__ import annotations
import argparse
import json
import sys
from pathlib import Path

# 把 lib 加进 sys.path
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

# Windows 控制台 UTF-8 兼容（避免 GBK 编码失败）
try:
    sys.stdout.reconfigure(encoding="utf-8")  # type: ignore[attr-defined]
    sys.stderr.reconfigure(encoding="utf-8")  # type: ignore[attr-defined]
except Exception:
    pass

from lib import project as P
from lib import render
from lib import words as W
from lib import lint as L
from lib import context as C
from lib import export as E
from lib import source as S
from lib import notes as N


# 向量检索（RAG）—— 软依赖，缺包时其它命令不受影响
try:
    from lib import vector as V  # type: ignore
    _VECTOR_OK = True
except ImportError:  # pragma: no cover
    V = None  # type: ignore
    _VECTOR_OK = False

# 动态写作空间（entity store）—— 软依赖
try:
    from lib import entity_store as ES  # type: ignore
    from lib import entity_extractors as EE  # type: ignore
    from lib import entity_schema as ESchema  # type: ignore
    from lib import writing_space as WS  # type: ignore
    from lib import outline_parser as OP  # type: ignore
    _ENTITY_OK = True
except ImportError:  # pragma: no cover
    ES = None  # type: ignore
    EE = None  # type: ignore
    ESchema = None  # type: ignore
    WS = None  # type: ignore
    OP = None  # type: ignore
    _ENTITY_OK = False


# ---------- 子命令实现 ----------


def _auto_index_after_stage(args_root: Path, chapter: int, kind: str) -> None:
    """自动索引钩子：被 stage/confirm 流程调用。

    kind: "outline" 或 "consistency"
    失败仅打警告，不抛错——索引是辅助能力，不阻塞主流程。
    """
    if not _VECTOR_OK:
        return  # lib.vector 导入失败，安静跳过
    try:
        store = V.open_store_with_default_provider(args_root)
        if kind == "outline":
            n = store.index_chapter_outline(chapter, force=False)
        elif kind == "consistency":
            n = store.index_chapter(chapter, force=True)
        else:
            return
        if n > 0:
            print(f"✓ auto-indexed: {kind} chapter {chapter} → {n} chunks")
    except Exception as e:
        print(f"⚠ auto-index failed ({kind} chapter {chapter}): {e}", file=sys.stderr)


def _resolve_root(args: argparse.Namespace) -> Path:
    """根据 --project 或 PWD 解析项目根。"""
    if getattr(args, "project", None):
        root = Path(args.project).resolve()
        if not (root / "project.yaml").is_file():
            sys.stderr.write(f"错误：{root}/project.yaml 不存在\n")
            sys.exit(2)
        return root
    found = P.find_project_root()
    if not found:
        sys.stderr.write("错误：未找到 project.yaml（请在项目目录内运行或使用 --project 指定）\n")
        sys.exit(2)
    return found


def cmd_init(args: argparse.Namespace) -> int:
    """新建项目。"""
    name = args.name
    out = Path(args.out or name).resolve()
    if out.exists() and any(out.iterdir()):
        sys.stderr.write(f"错误：目标目录 {out} 已存在且非空\n")
        return 2
    out.mkdir(parents=True, exist_ok=True)

    # 计算 chapter_target_words
    target_words = int(args.target)
    target_volumes = int(args.volumes)
    if args.chapter_words:
        chapter_target_words = int(args.chapter_words)
    else:
        # 业界惯例：每章约 3000 字（中文网文标准）
        # 估算章节数 = target_words / 3000
        chapter_target_words = 3000

    now = P._utcnow_str()
    pipeline: dict[str, dict] = {}
    for _, key, _ in P.STAGES:
        pipeline[key] = {"status": P.STATUS_NOT_STARTED, "confirmedAt": None, "outputFiles": []}

    data = {
        "name": name,
        "author": args.author or "",
        "description": args.premise or "",
        "created": now,
        "last_modified": now,
        "version": 1,
        "genre": args.genre or "",
        "sub_genre": "",
        "target_words": target_words,
        "target_volumes": target_volumes,
        "chapter_target_words": chapter_target_words,
        "premise": args.premise or "",
        "pipeline": pipeline,
        "chapters": {"total": 0, "written": 0, "confirmed": 0},
        "consistency": {"last_check_chapter": 0, "last_check_date": None, "status": P.STATUS_NOT_STARTED},
    }

    P.save_project(out, data)

    # 创建产出占位文件
    for _, key, name_cn in P.STAGES:
        for rel in P.STAGE_OUTPUTS.get(key, []):
            if rel.endswith(".gitkeep"):
                (out / rel).parent.mkdir(parents=True, exist_ok=True)
                (out / rel).touch()
                continue
            target = out / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            title = f"# {name_cn}\n\n（待 {name_cn} 阶段产出）\n"
            target.write_text(title, encoding="utf-8")

    print(f"✓ 项目已创建：{out}")
    print(f"  路径: {out}")
    print(f"  题材: {data['genre']}")
    print(f"  目标字数: {target_words}")
    print(f"  目标卷数: {target_volumes}")
    print(f"  每章目标字数: {chapter_target_words}（默认 3000；如需调整，使用 --chapter-words 参数）")
    if not args.chapter_words:
        est = round(target_words / chapter_target_words)
        print(f"  估算章节数: {est}")
        print(f"  💡 玄幻长篇建议 80-120 章（按 3000 字/章）；如需更短或更长章节，使用 --chapter-words 调整")
    print()
    print("下一阶段：01 题材分析（genre-analysis.md）")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    data = P.load_project(root)
    print(render.render_status_panel(data, root))
    return 0


def cmd_stage(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    data = P.load_project(root)
    sub = args.sub

    if sub == "next" or sub is None:
        nxt = P.next_runnable_stage(data)
        if nxt is None:
            if P.all_confirmed(data):
                print("全部阶段已完成")
            else:
                print("无下一个可执行阶段（等待上游阶段确认）")
            return 0
        num, key, name_cn = nxt
        print(f"阶段 {num} · {name_cn}（{key}）")
        return 0

    if sub == "chapter":
        # 用法:
        #   fictia stage chapter increment
        #   fictia stage chapter set --total N --written N --confirmed N
        #   fictia stage chapter outline --chapter N
        #   fictia stage chapter next
        #   fictia stage chapter status
        action = args.stage
        if action == "increment":
            P.increment_chapters(data, 1)
            P.save_project(root, data)
            ch = data.get("chapters", {})
            print(f"chapters: written={ch.get('written')}, confirmed={ch.get('confirmed')}")
            return 0
        if action == "set":
            ch = data.setdefault("chapters", {"total": 0, "written": 0, "confirmed": 0, "outlines": {}})
            for k in ("total", "written", "confirmed"):
                v = getattr(args, k, None)
                if v is not None:
                    ch[k] = int(v)
            P.save_project(root, data)
            print(f"chapters: {ch}")
            return 0
        if action == "outline":
            n_str = getattr(args, "chapter", None)
            if not n_str:
                sys.stderr.write("用法: stage chapter outline --chapter <N>\n")
                return 2
            n = int(n_str)
            outline_path = root / "outline" / "chapters" / f"ch{n:02d}.md"
            if not outline_path.is_file():
                sys.stderr.write(
                    f"错误：{outline_path.relative_to(root)} 不存在；请先生成该章大纲\n"
                )
                return 2
            missing = [
                s for s in P.DESIGN_STAGES
                if P.get_stage_status(data, s) != P.STATUS_CONFIRMED
            ]
            if missing:
                sys.stderr.write(
                    f"错误：上游设计阶段未确认：{', '.join(missing)}\n"
                    "请先完成 style / art_design / narrative_weave / world / characters 阶段\n"
                )
                return 2
            P.mark_chapter_outline(data, n)
            P.save_project(root, data)
            print(f"✓ ch{n:02d} 大纲已标记就绪（并行模式已自动开启）")
            print(f"  → 用 `fictia stage chapter next` 查看下一可写章节")
            # 自动索引钩子 A：outline 就绪 → 索引大纲
            _auto_index_after_stage(root, n, "outline")
            return 0
        if action == "next":
            nxt = P.next_chapter_to_write(data, root)
            if nxt is None:
                if not P.is_parallel_design_enabled(data):
                    print("并行模式未开启（用 `fictia parallel-design on` 启用）")
                    print("或保持串行模式：先完成 story 阶段全部章节大纲")
                else:
                    print("无下一可写章节（所有已就绪大纲均已写完，或上游设计未全部确认）")
                return 1
            print(f"下一可写章节: ch{nxt:02d}")
            return 0
        if action == "status":
            ch = data.get("chapters", {})
            outlines_map = ch.get("outlines") or {}
            written = int(ch.get("written") or 0)
            confirmed = int(ch.get("confirmed") or 0)
            total = int(ch.get("total") or 0)
            lines = [
                f"大纲就绪: {len(outlines_map)} 章",
                f"已写: {written} 章",
                f"已确认: {confirmed} 章",
            ]
            if total:
                lines.append(f"计划: {total} 章")
            if outlines_map:
                lines.append("---")
                for cn in sorted(outlines_map.keys()):
                    n = int(cn[2:])
                    marker = "✓" if n <= written else "·"
                    lines.append(f"  {marker} {cn} 大纲就绪于 {outlines_map[cn]}")
            print("\n".join(lines))
            return 0
        sys.stderr.write(
            "用法: stage chapter increment | set --total N --written N --confirmed N\n"
            "     | outline --chapter N | next | status\n"
        )
        return 2

    if sub == "show":
        num = P.STAGE_NUM.get(args.stage, "?")
        status = P.get_stage_status(data, args.stage)
        sym = render.SYMBOLS.get(status, "[?]")
        print(f"{num} {P.STAGE_NAME.get(args.stage, '?')} {sym} {status}")
        return 0

    if sub in ("ready", "confirm", "invalidate", "start", "fail", "reset"):
        new_status = {
            "ready": P.STATUS_PENDING_CONFIRM,
            "confirm": P.STATUS_CONFIRMED,
            "invalidate": P.STATUS_NEEDS_UPDATE,
            "start": P.STATUS_IN_PROGRESS,
            "fail": P.STATUS_FAILED,
            "reset": P.STATUS_NOT_STARTED,
        }[sub]
        prev = P.get_stage_status(data, args.stage)
        P.set_stage_status(data, args.stage, new_status)
        # invalidate 还要传播
        changed: list[str] = []
        if sub == "invalidate":
            changed = P.invalidate_downstream(data, args.stage)
        P.save_project(root, data)
        print(f"{args.stage}: {prev} → {new_status}")
        if changed:
            print(f"  下游标记为 needs_update: {', '.join(changed)}")
        return 0

    sys.stderr.write(f"未知子命令：{sub}\n")
    return 2


def cmd_words(args: argparse.Namespace) -> int:
    total = 0
    for f in args.files:
        try:
            r = W.count_file(f)
        except FileNotFoundError:
            sys.stderr.write(f"未找到：{f}\n")
            return 2
        suffix = "（写作备注已剥离）" if r["has_writing_notes"] else "（无 写作备注）"
        print(f"{r['path']}: {r['words']} 字 {suffix}")
        total += r["words"]
    if len(args.files) > 1:
        print(f"合计：{total} 字")
    return 0


def cmd_judge(args: argparse.Namespace) -> int:
    actual = int(args.actual)
    target = int(args.target)
    r = W.judge(actual, target)
    icon = {"达标": "✅", "轻微不足": "⚠️", "严重不足": "❌", "unknown": "?"}[r["verdict"]]
    print(f"{icon} {r['verdict']}（{r['ratio'] * 100:.1f}%, {r['delta']:+d} 字）")
    return 0


def cmd_milestone(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    data = P.load_project(root)
    hit, val = P.get_milestone(data)
    chapters = data.get("chapters") or {}
    confirmed = int(chapters.get("confirmed") or 0)
    if hit:
        print(f"✓ 已到达里程碑：第 {val} 章")
        print(f"  → 必须触发一致性校验（一致性报告：reviews/consistency-report.md）")
    else:
        if val == 0:
            print(f"尚未确认任何章节（当前 0 章）")
        else:
            print(f"未到里程碑（已确认 {confirmed} 章，下一里程碑：第 {val} 章）")
    return 0


def cmd_consistency(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    data = P.load_project(root)
    if args.sub != "confirm":
        sys.stderr.write("用法: consistency confirm --chapter <N>\n")
        return 2
    ch = int(args.chapter)
    consistency = data.setdefault("consistency", {})
    consistency["last_check_chapter"] = ch
    consistency["last_check_date"] = P._utcnow_str()
    consistency["status"] = P.STATUS_CONFIRMED
    P.save_project(root, data)
    print(f"consistency: confirmed at chapter {ch}")
    # 自动索引钩子 B：consistency confirm → 索引完整章节正文
    _auto_index_after_stage(root, ch, "consistency")
    return 0


def cmd_parallel_design(args: argparse.Namespace) -> int:
    """并行模式开关（默认关闭）。"""
    root = _resolve_root(args)
    data = P.load_project(root)
    action = args.action
    if action == "on":
        P.set_parallel_design(data, True)
        P.save_project(root, data)
        print("✓ 并行模式已开启")
        print("  → 故事设计完成的章节可立即进入章节写作")
        print("  → 用 `fictia stage chapter outline <N>` 标记大纲就绪")
        print("  → 用 `fictia stage chapter next` 查看下一可写章节")
        return 0
    if action == "off":
        P.set_parallel_design(data, False)
        P.save_project(root, data)
        print("✓ 并行模式已关闭")
        print("  → 恢复'全部故事设计完成后才能写作'的严格顺序")
        return 0
    if action == "status":
        enabled = P.is_parallel_design_enabled(data)
        print(f"并行模式: {'开启' if enabled else '关闭'}")
        return 0
    sys.stderr.write("用法: parallel-design on|off|status\n")
    return 2


def cmd_brainstorm_mode(args: argparse.Namespace) -> int:
    """头脑风暴模式开关（默认开启）。"""
    root = _resolve_root(args)
    data = P.load_project(root)
    action = args.action
    if action == "on":
        P.set_brainstorm_mode(data, True)
        P.save_project(root, data)
        print("✓ 头脑风暴模式已开启（设计阶段默认进入探索→共创→产出三段式）")
        return 0
    if action == "off":
        P.set_brainstorm_mode(data, False)
        P.save_project(root, data)
        print("✓ 头脑风暴模式已关闭（设计阶段直接产出）")
        return 0
    if action == "status":
        enabled = P.is_brainstorm_mode_enabled(data)
        print(f"头脑风暴模式: {'开启' if enabled else '关闭'}")
        return 0
    sys.stderr.write("用法: brainstorm-mode on|off|status\n")
    return 2


def cmd_source(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    if args.sub == "import":
        if not args.file:
            sys.stderr.write("source import 需要文件路径\n")
            return 2
        try:
            out = S.import_source(root, Path(args.file), args.workflow, args.title)
        except Exception as e:
            sys.stderr.write(f"源文本导入失败：{e}\n")
            return 2
        print(f"✓ 源文本已导入：{out.relative_to(root)}")
        print(f"  工作流: {args.workflow}")
        print("  下一步: 使用现有 01-11 阶段完成题材分析、风格提取、故事设计与章节写作")
        return 0
    if args.sub == "list":
        entries = S.list_sources(root)
        if not entries:
            print("（无源文本素材）")
            return 0
        for i, item in enumerate(entries, start=1):
            print(f"{i}. {item.get('title', '')} [{item.get('workflow', '')}/{item.get('format', '')}] -> {item.get('text', '')}")
        return 0
    sys.stderr.write("用法: source import <file> --workflow <rewrite|imitation|continuation> 或 source list\n")
    return 2


def cmd_ctx(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    program = args.program
    cache_dir = root / ".fictia-cache"
    cache_dir.mkdir(exist_ok=True)

    # 从 positional 解析出 chapter/name/act/role（按 program 决定）
    raw = args.arg

    if program == "character-registry":
        print(C.build_character_registry(root))
    elif program == "character-card":
        name = args.name or raw
        if not name:
            sys.stderr.write("character-card 需要角色名：fictia ctx character-card <名字>\n")
            return 2
        print(C.build_character_quick_card(root, name))
    elif program == "world-quickref":
        print(C.build_world_quickref(root))
    elif program in ("chapter-weave", "chapter-art", "previous-chapter", "chapter-act"):
        ch_str = args.chapter or raw
        if not ch_str:
            sys.stderr.write(f"{program} 需要章节号：fictia ctx {program} <章节号>\n")
            return 2
        ch = int(ch_str)
        if program == "chapter-weave":
            print(C.extract_chapter_narrative_weave(root, ch))
        elif program == "chapter-art":
            print(C.extract_chapter_art_design(root, ch))
        elif program == "previous-chapter":
            print(C.build_previous_chapter_summary(root, ch))
        elif program == "chapter-act":
            act = C.chapter_act(root, ch)
            print(f"第 {ch} 章 → {act}")
    elif program == "style-act":
        act = args.act or raw
        if not act:
            sys.stderr.write("style-act 需要幕名：fictia ctx style-act <act-1/2/3/prologue/epilogue>\n")
            return 2
        print(C.extract_style_stage_notes(root, act))
    elif program == "semantic-search":
        # semantic-search 用 vector 库；缺包或缺依赖时给清晰错误
        if not _VECTOR_OK:
            sys.stderr.write("错误：lib.vector 导入失败，无法做语义检索。\n")
            return 2
        query = args.query or raw
        if not query:
            sys.stderr.write("semantic-search 需要查询语句：fictia ctx semantic-search \"<query>\" [--top-k 8]\n")
            return 2

        # server 模式：走 HTTP，避免本地 open_store 与 server 持有的 zvec 锁冲突
        import os
        if os.environ.get("FICTIA_EMBEDDING", "").lower() == "server":
            try:
                import httpx
                server_url = os.environ.get("FICTIA_EMBED_SERVER", "http://127.0.0.1:8700")
                resp = httpx.post(
                    f"{server_url}/search",
                    json={
                        "query": query,
                        "collection": args.collection or "chapters",
                        "top_k": args.top_k,
                    },
                    timeout=30,
                )
                resp.raise_for_status()
                results = resp.json()["results"]
            except Exception as e:
                sys.stderr.write(f"错误：server semantic-search 失败：{e}\n")
                return 2
            coll_name = args.collection or "chapters"
            hits = [
                V.Hit(
                    id=h.get("id", "?"),
                    collection=coll_name,
                    text=h.get("text", ""),
                    score=h.get("score", 0.0),
                    metadata=h.get("metadata", {}),
                )
                for h in results
            ]
        else:
            # 本地模式
            try:
                store = V.open_store_with_default_provider(root)
                hits = store.search(query, top_k=args.top_k, collection=args.collection)
            except V.VectorError as e:
                sys.stderr.write(f"错误：{e}\n")
                return 2

        # 输出：优先 markdown（format_semantic_search），退化时走简单列表
        if hasattr(C, "format_semantic_search"):
            out = C.format_semantic_search(hits, query)
            print(out if out else "(无命中)")
            return 0
        if not hits:
            print("(无命中)")
            return 0
        for i, h in enumerate(hits, 1):
            ch = h.metadata.get("chapter", "-")
            print(f"[{i}] {h.collection} chapter={ch} score={h.score:.4f}")
            snippet = h.text.replace("\n", " ").strip()
            if len(snippet) > 200:
                snippet = snippet[:200] + "..."
            print(f"    > {snippet}")
        return 0
    elif program == "weave-summary":
        print(C.build_narrative_weave_summary(root))
    elif program == "art-summary":
        print(C.build_art_design_summary(root))
    elif program == "assemble":
        # raw 可能是 "writer" / "editor" / "consistency" / 章节号 / 角色名等
        # 优先 args.role，否则看 raw
        role = args.role
        if not role and raw in ("writer", "editor", "consistency"):
            role = raw
        if not role:
            sys.stderr.write("assemble 需要 role：fictia ctx assemble <writer|editor|consistency> [章节号]\n")
            return 2
        if role == "consistency":
            out = cache_dir / "consistency-context.md"
            out.write_text(C.assemble_consistency_context(root), encoding="utf-8")
            print(f"✓ 已写入：{out}")
        else:
            # chapter 优先 args.chapter，否则 raw（但 raw 这时已被用作 role）
            ch_str = args.chapter
            if not ch_str:
                sys.stderr.write(f"assemble {role} 需要章节号：fictia ctx assemble {role} --chapter <N> 或先传 role\n")
                return 2
            ch = int(ch_str)
            if role == "writer":
                out = cache_dir / f"ch{ch:02d}-writer-context.md"
                out.write_text(C.assemble_writer_context(root, ch), encoding="utf-8")
                print(f"✓ 已写入：{out}")
            else:
                out = cache_dir / f"ch{ch:02d}-editor-context.md"
                out.write_text(C.assemble_editor_context(root, ch), encoding="utf-8")
                print(f"✓ 已写入：{out}")
    elif program == "writing-space":
        if not _ENTITY_OK:
            sys.stderr.write("错误：entity 模块导入失败，无法组装写作空间。\n")
            return 2
        ch_str = args.chapter or raw
        if not ch_str:
            sys.stderr.write("writing-space 需要章节号：fictia ctx writing-space --chapter <N>\n")
            return 2
        ch = int(ch_str)
        try:
            content = WS.assemble_writing_space(root, ch)
        except Exception as e:
            sys.stderr.write(f"错误：组装写作空间失败：{e}\n")
            return 2
        out = cache_dir / f"ch{ch:02d}-writing-space.md"
        out.write_text(content, encoding="utf-8")
        print(f"✓ 已写入：{out}")
    else:
        sys.stderr.write(f"未知 ctx 程序: {program}\n")
        sys.stderr.write("可用: character-registry, character-card, world-quickref, chapter-weave, chapter-art, style-act, weave-summary, art-summary, previous-chapter, chapter-act, assemble\n")
        return 2
    return 0


def cmd_verdict(args: argparse.Namespace) -> int:
    kind = args.kind
    path = Path(args.file)
    if not path.is_file():
        sys.stderr.write(f"未找到：{path}\n")
        return 2
    text = path.read_text(encoding="utf-8")
    if kind == "review":
        v = C.parse_review_verdict(text)
        print(json.dumps(v, ensure_ascii=False, indent=2))
        if v["passed"]:
            print("✅ 通过")
        else:
            print("❌ 未通过")
        return 0 if v["passed"] else 1
    elif kind == "consistency":
        # 复用同一解析器（结构相同）
        v = C.parse_review_verdict(text)
        print(json.dumps(v, ensure_ascii=False, indent=2))
        if v["passed"]:
            print("✅ 通过")
        else:
            print("❌ 未通过")
        return 0 if v["passed"] else 1
    else:
        sys.stderr.write(f"未知 verdict 类型：{kind}\n")
        return 2


def cmd_export(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    try:
        out = E.export(root, args.format)
    except FileNotFoundError as e:
        sys.stderr.write(f"错误：{e}\n")
        return 2
    except ValueError as e:
        sys.stderr.write(f"错误：{e}\n")
        return 2
    ch_dir = root / "chapters"
    n = len(list(ch_dir.rglob("ch*.md"))) if ch_dir.is_dir() else 0
    print(f"✓ 已导出 {n} 章 → {out}")
    return 0


def cmd_lint(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    issues = L.lint_project(root)
    if not issues:
        print("✓ 项目结构无问题")
        return 0
    by_level: dict[str, list[dict]] = {"error": [], "warning": [], "info": []}
    for i in issues:
        by_level.setdefault(i["level"], []).append(i)
    for level in ("error", "warning", "info"):
        items = by_level.get(level, [])
        if not items:
            continue
        icon = {"error": "✗", "warning": "⚠", "info": "ℹ"}[level]
        print(f"{icon} {level.upper()}（{len(items)}）")
        for i in items:
            print(f"  [{i['code']}] {i['message']}")
            print(f"    → {i['path']}")
    return 1 if by_level.get("error") else 0


def cmd_notes(args: argparse.Namespace) -> int:
    root = _resolve_root(args)
    sub = args.sub

    if sub == "add":
        if not args.text:
            sys.stderr.write("notes add 需要 --text 参数\n")
            return 2
        new_id = N.add(
            root,
            text=args.text,
            source=args.source or "user",
            stage=args.stage or "",
            chapter=args.chapter or "",
        )
        print(f"✓ 已记录笔记：{new_id}")
        return 0

    if sub == "list":
        status = args.status
        entries = N.list_entries(root, status=status)
        if not entries:
            print(f"（无{' ' + status if status else ''}笔记）")
            return 0
        for e in entries:
            text = e["fields"].get("原始文本", "")
            st = e["fields"].get("状态", "?")
            print(f"{e['id']} [{st}] {text}")
        return 0

    if sub == "show":
        e = N.show(root, args.id)
        if e is None:
            sys.stderr.write(f"未找到笔记：{args.id}\n")
            return 2
        print(f"## {e['id']} · {e['timestamp']}")
        for k, v in e["fields"].items():
            print(f"- **{k}**：{v}")
        return 0

    if sub == "link":
        if not args.to:
            sys.stderr.write("notes link 需要 --to 参数（格式: file.md#section）\n")
            return 2
        ok = N.link(root, args.id, args.to)
        if not ok:
            sys.stderr.write(f"未找到笔记：{args.id}\n")
            return 2
        print(f"✓ {args.id} → {args.to}")
        return 0

    if sub == "revert":
        ok = N.revert(root, args.id)
        if not ok:
            sys.stderr.write(f"未找到笔记：{args.id}\n")
            return 2
        print(f"✓ {args.id} 已 revert（raw 记录保留，summary 条目移除）")
        return 0

    sys.stderr.write("用法: notes add|list|show|link|revert [...]\n")
    return 2


def cmd_vector(args: argparse.Namespace) -> int:
    """向量检索管理（RAG）。"""
    if not _VECTOR_OK:
        sys.stderr.write("错误：lib.vector 导入失败。请检查 scripts/lib/vector.py 是否存在。\n")
        return 2
    try:
        root = _resolve_root(args)
    except SystemExit:
        return 2

    sub_cmd = args.vec_cmd

    # server 模式下 search/status 不需要打开本地 store
    import os
    _is_server = os.environ.get("FICTIA_EMBEDDING", "").lower() == "server"

    # search 走 server 时跳过 store 初始化
    if sub_cmd == "search" and _is_server:
        pass  # 下方 search 分支会走 HTTP
    else:
        try:
            store = V.open_store_with_default_provider(root)
        except V.VectorError as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        except Exception as e:
            sys.stderr.write(f"错误：初始化向量存储失败：{e}\n")
            return 2

    if sub_cmd == "status":
        s = store.status()
        print(f"embedding: {s['embedding_model']} (dim={s['vector_dim']})")
        for name, count in s["collections"].items():
            print(f"  {name}: {count} chunks")
        print(f"  total: {s['total_chunks']} chunks")
        return 0

    if sub_cmd == "index-chapter":
        ch_str = args.chapter
        if not ch_str:
            sys.stderr.write("用法: vector index-chapter --chapter <N> [--force]\n")
            return 2
        ch = int(ch_str)
        try:
            n = store.index_chapter(ch, force=args.force)
        except V.VectorError as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        print(f"✓ chapter {ch}: indexed {n} chunks" + (" (force)" if args.force else ""))
        return 0

    if sub_cmd == "index-notes":
        try:
            n = store.index_notes(force=args.force)
        except V.VectorError as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        if n == 0:
            print("(notes/summary.md 不存在，跳过)")
        else:
            print(f"✓ notes: indexed {n} chunks" + (" (force)" if args.force else ""))
        return 0

    if sub_cmd == "index-source":
        try:
            n = store.index_sources(force=args.force)
        except V.VectorError as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        if n == 0:
            print("(sources/ 目录不存在或为空，跳过)")
        else:
            print(f"✓ sources: indexed {n} chunks" + (" (force)" if args.force else ""))
        return 0

    if sub_cmd == "index-all":
        total = 0
        for label, fn in [
            ("notes", store.index_notes),
            ("sources", store.index_sources),
        ]:
            try:
                total += fn(force=args.force)
            except V.VectorError as e:
                sys.stderr.write(f"⚠ {label}: {e}\n")
        # 索引所有已写章节
        for ch in range(1, 200):
            p = V.chapter_file_path(root, ch)
            if p:
                try:
                    total += store.index_chapter(ch, force=args.force)
                except V.VectorError as e:
                    sys.stderr.write(f"⚠ chapter {ch}: {e}\n")
            else:
                # 找不到 act-X/chNN.md 时停止（章节号是连续的）
                if ch > 1:
                    break
        print(f"✓ index-all: total {total} chunks" + (" (force)" if args.force else ""))
        return 0

    if sub_cmd == "search":
        query = args.query
        if not query:
            sys.stderr.write("用法: vector search --query \"<query>\" [--top-k N] [--collection X]\n")
            return 2

        # server 模式：走 HTTP
        import os
        if os.environ.get("FICTIA_EMBEDDING", "").lower() == "server":
            try:
                import httpx
                server_url = os.environ.get("FICTIA_EMBED_SERVER", "http://127.0.0.1:8700")
                resp = httpx.post(
                    f"{server_url}/search",
                    json={
                        "query": query,
                        "collection": args.collection or "chapters",
                        "top_k": args.top_k,
                    },
                    timeout=30,
                )
                resp.raise_for_status()
                results = resp.json()["results"]
                if not results:
                    print("(无命中)")
                    return 0
                for i, h in enumerate(results, 1):
                    ch = h.get("metadata", {}).get("chapter", "-")
                    print(f"[{i}] {h.get('id', '?')} chapter={ch} score={h.get('score', 0):.4f}")
                    snippet = h.get("text", "").replace("\n", " ").strip()
                    if len(snippet) > 200:
                        snippet = snippet[:200] + "..."
                    print(f"    > {snippet}")
                return 0
            except Exception as e:
                sys.stderr.write(f"警告：server search 失败，回退到本地：{e}\n")

        # 本地模式
        try:
            hits = store.search(query, top_k=args.top_k, collection=args.collection)
        except V.VectorError as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        if not hits:
            print("(无命中)")
            return 0
        for i, h in enumerate(hits, 1):
            ch = h.metadata.get("chapter", "-")
            print(f"[{i}] {h.collection} chapter={ch} score={h.score:.4f} id={h.id}")
            snippet = h.text.replace("\n", " ").strip()
            if len(snippet) > 200:
                snippet = snippet[:200] + "..."
            print(f"    > {snippet}")
        return 0

    if sub_cmd == "clear":
        if not args.yes:
            target = args.collection or "ALL"
            print(f"确认清空向量数据（{target}）？加 --yes 跳过确认。")
            return 1
        try:
            cleared = store.clear(collection=args.collection)
        except V.VectorError as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        print(f"✓ cleared: {', '.join(cleared)}")
        return 0

    sys.stderr.write("用法: vector index-chapter|index-notes|index-source|index-all|search|status|clear [...]\n")
    return 2


def cmd_entity(args: argparse.Namespace) -> int:
    """动态写作空间 — 实体管理。"""
    if not _ENTITY_OK:
        sys.stderr.write(
            "错误：entity 模块导入失败。请检查 scripts/lib/entity_*.py 是否存在。\n"
        )
        return 2
    root = _resolve_root(args)
    sub_cmd = args.entity_cmd

    try:
        store = ES.open_entity_store_with_default_provider(root)
    except Exception as e:
        sys.stderr.write(f"错误：初始化 entity store 失败：{e}\n")
        return 2

    # entity index-all
    if sub_cmd == "index-all":
        all_docs = EE.extract_all(root)
        total = 0
        for col_name, docs in all_docs.items():
            try:
                n = store.upsert_entities(docs)
                total += n
                print(f"  {col_name}: {n} entities")
            except Exception as e:
                sys.stderr.write(f"  ⚠ {col_name}: {e}\n")
        print(f"✓ entity index-all: total {total} entities")
        return 0

    # entity index <collection>
    if sub_cmd == "index":
        col_name = args.collection
        if not col_name:
            sys.stderr.write("用法: entity index <collection>\n")
            return 2
        docs = EE.extract_collection(root, col_name)
        try:
            n = store.upsert_entities(docs)
        except Exception as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        print(f"✓ {col_name}: indexed {n} entities")
        return 0

    # entity status
    if sub_cmd == "status":
        s = store.status()
        print(f"embedding: {s['embedding_model']} (dim={s['vector_dim']})")
        for name, count in s["collections"].items():
            print(f"  {name}: {count} entities")
        print(f"  total: {s['total_entities']} entities")
        return 0

    # entity list <collection> [--state <state>]
    if sub_cmd == "list":
        col_name = args.collection
        if not col_name:
            sys.stderr.write("用法: entity list <collection> [--state <state>]\n")
            return 2
        entities = store.list_entities(col_name, state=args.state)
        if not entities:
            print(f"（{col_name} 中无{' ' + args.state if args.state else ''}实体）")
            return 0
        for e in entities:
            name = e.get("name", e.get("id", "?"))
            state = e.get("state", "?")
            ver = e.get("version", "?")
            print(f"  {e.get('id', '?')} [{state}] v{ver} {name}")
        print(f"共 {len(entities)} 个实体")
        return 0

    # entity get <collection> <entity_id>
    if sub_cmd == "get":
        col_name = args.collection
        eid = args.entity_id
        if not col_name or not eid:
            sys.stderr.write("用法: entity get <collection> <entity_id>\n")
            return 2
        entity = store.get_entity(col_name, eid)
        if entity is None:
            sys.stderr.write(f"未找到：{eid}\n")
            return 2
        import json
        print(json.dumps(entity, ensure_ascii=False, indent=2))
        return 0

    # entity search [--collection <col>] [--state <state>] [--top-k N] query
    if sub_cmd == "search":
        query = args.query
        if not query:
            sys.stderr.write("用法: entity search \"<query>\" [--collection <col>] [--state <state>] [--top-k N]\n")
            return 2

        # server 模式：走 HTTP，避免本地打开 collection
        import os
        if os.environ.get("FICTIA_EMBEDDING", "").lower() == "server":
            try:
                import httpx
                server_url = os.environ.get("FICTIA_EMBED_SERVER", "http://127.0.0.1:8700")
                resp = httpx.post(
                    f"{server_url}/entity/search",
                    json={
                        "query": query,
                        "collection": args.collection,
                        "top_k": args.top_k,
                        "state": args.state,
                    },
                    timeout=30,
                )
                resp.raise_for_status()
                results = resp.json()["results"]
                if not results:
                    print("（无命中）")
                    return 0
                for i, e in enumerate(results, 1):
                    name = e.get("name", "?")
                    state = e.get("state", "?")
                    col = e.get("collection", args.collection or "?")
                    score = e.get("score", 0)
                    print(f"[{i}] {name} [{state}] score={score:.4f}")
                    snippet = e.get("text", "").replace("\n", " ").strip()
                    if len(snippet) > 200:
                        snippet = snippet[:200] + "..."
                    print(f"    > {snippet}")
                return 0
            except Exception as e:
                sys.stderr.write(f"警告：server entity search 失败，回退到本地：{e}\n")

        # 本地模式
        from lib.entity_retriever import EntityRetriever
        retriever = EntityRetriever(store)
        results = retriever.retrieve_on_demand(
            query,
            collection=args.collection,
            top_k=args.top_k,
            state=args.state,
        )
        if not results:
            print("（无命中）")
            return 0
        for i, e in enumerate(results, 1):
            name = e.get("name", "?")
            state = e.get("state", "?")
            col = e.get("_collection", args.collection or "?")
            score = e.get("score", 0)
            print(f"[{i}] {name} [{state}] score={score:.4f}")
            snippet = e.get("text", "").replace("\n", " ").strip()
            if len(snippet) > 200:
                snippet = snippet[:200] + "..."
            print(f"    > {snippet}")
        return 0

    # entity update <collection> <entity_id> --state <state> --state-ch <N>
    if sub_cmd == "update":
        col_name = args.collection
        eid = args.entity_id
        new_state = args.state
        state_ch = args.state_ch
        if not col_name or not eid or not new_state:
            sys.stderr.write("用法: entity update <collection> <entity_id> --state <state> --state-ch <N>\n")
            return 2
        state_ch_int = int(state_ch) if state_ch else 0
        extra_fields = {}
        if args.fields:
            for f in args.fields:
                if "=" in f:
                    k, v = f.split("=", 1)
                    extra_fields[k.strip()] = v.strip()
        ok = store.update_entity_state(
            col_name, eid, new_state, state_ch_int,
            new_text=args.text, extra_fields=extra_fields or None,
        )
        if ok:
            print(f"✓ {eid}: → {new_state} (ch{state_ch_int:02d})")
        else:
            sys.stderr.write(f"✗ 更新失败（状态转移不合法或实体不存在）：{eid}\n")
            return 2
        return 0

    # entity clear [--collection <col>] [--yes]
    if sub_cmd == "clear":
        if not args.yes:
            target = args.collection or "ALL"
            print(f"确认清空 entity 数据（{target}）？加 --yes 跳过确认。")
            return 1
        try:
            cleared = store.clear(collection=args.collection)
        except Exception as e:
            sys.stderr.write(f"错误：{e}\n")
            return 2
        print(f"✓ cleared: {', '.join(cleared)}")
        return 0

    # entity outline-hints --chapter N（调试用）
    if sub_cmd == "outline-hints":
        ch_str = args.chapter
        if not ch_str:
            sys.stderr.write("用法: entity outline-hints --chapter <N>\n")
            return 2
        ch = int(ch_str)
        hints = OP.parse_outline_for_chapter(root, ch)
        print(OP.format_outline_hints(hints))
        return 0

    sys.stderr.write(
        "用法: entity index-all|index|status|list|get|search|update|clear|outline-hints [...]\n"
    )
    return 2


# ---------- argparse 配置 ----------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="fictia",
        description="Fictia AI 小说创作流水线 CLI 工具",
    )
    parser.add_argument("--project", "-p", help="项目目录（默认：从当前目录向上查找 project.yaml）")
    sub = parser.add_subparsers(dest="cmd")

    # init
    p_init = sub.add_parser("init", help="新建项目")
    p_init.add_argument("name", help="项目名（英文，用作目录名）")
    p_init.add_argument("--author", help="作者名")
    p_init.add_argument("--genre", help="题材（如 玄幻/都市/科幻）")
    p_init.add_argument("--target", default="300000", help="目标字数（默认 300000）")
    p_init.add_argument("--volumes", default="1", help="目标卷数（默认 1）")
    p_init.add_argument("--chapter-words", help="每章目标字数（不指定则自动计算）")
    p_init.add_argument("--premise", help="核心设定（一段话）")
    p_init.add_argument("--out", help="输出目录（默认 ./<name>）")
    p_init.set_defaults(func=cmd_init)

    # status
    p_status = sub.add_parser("status", help="渲染状态面板")
    p_status.set_defaults(func=cmd_status)

    # stage
    p_stage = sub.add_parser("stage", help="流水线阶段管理")
    p_stage.add_argument("sub", nargs="?", default="next",
                         choices=["next", "show", "ready", "confirm", "invalidate", "start", "fail", "reset", "chapter"],
                         help="子操作")
    p_stage.add_argument("stage", nargs="?", help="阶段 key（如 architecture）或 chapter 子动作")
    p_stage.add_argument("--total", help="chapter set 用的总章节数")
    p_stage.add_argument("--written", help="chapter set 用的已写数")
    p_stage.add_argument("--confirmed", help="chapter set 用的已确认数")
    p_stage.add_argument("--chapter", "-c", help="chapter outline 用的章节号")
    p_stage.set_defaults(func=cmd_stage, stage_action=None)

    # parallel-design
    p_pd = sub.add_parser("parallel-design", help="并行模式开关（故事设计 + 章节写作可同时进行；默认关闭）")
    p_pd.add_argument("action", choices=["on", "off", "status"], help="on=启用 off=关闭 status=查询")
    p_pd.set_defaults(func=cmd_parallel_design)

    # brainstorm-mode
    p_bm = sub.add_parser("brainstorm-mode", help="头脑风暴模式开关（设计阶段探索→共创→产出；默认开启）")
    p_bm.add_argument("action", choices=["on", "off", "status"], help="on=开启 off=关闭 status=查询")
    p_bm.set_defaults(func=cmd_brainstorm_mode)

    # words
    p_words = sub.add_parser("words", help="统计字数")
    p_words.add_argument("files", nargs="+", help="要统计的 md 文件")
    p_words.set_defaults(func=cmd_words)

    # judge
    p_judge = sub.add_parser("judge", help="字数判定")
    p_judge.add_argument("actual", help="实际字数")
    p_judge.add_argument("target", help="目标字数")
    p_judge.set_defaults(func=cmd_judge)

    # milestone
    p_ms = sub.add_parser("milestone", help="检查章节里程碑")
    p_ms.set_defaults(func=cmd_milestone)

    # consistency
    p_consistency = sub.add_parser("consistency", help="一致性校验状态管理")
    p_consistency.add_argument("sub", choices=["confirm"], help="子操作")
    p_consistency.add_argument("--chapter", required=True, help="已通过一致性校验的章节号")
    p_consistency.set_defaults(func=cmd_consistency)

    # source
    p_source = sub.add_parser("source", help="源文本素材管理（epub/txt/md）")
    p_source.add_argument("sub", choices=["import", "list"], help="子操作")
    p_source.add_argument("file", nargs="?", help="import 用的源文本文件")
    p_source.add_argument("--workflow", choices=list(S.SOURCE_WORKFLOWS), default="rewrite", help="源文本工作流")
    p_source.add_argument("--title", help="源文本标题（默认取文件名）")
    p_source.set_defaults(func=cmd_source)

    # ctx
    p_ctx = sub.add_parser("ctx", help="上下文压缩与组装")
    p_ctx.add_argument("program",
                       choices=["character-registry", "character-card", "world-quickref",
                                "chapter-weave", "chapter-art", "style-act",
                                "weave-summary", "art-summary", "previous-chapter",
                                "chapter-act", "assemble", "semantic-search",
                                "writing-space"],
                       help="ctx 程序")
    p_ctx.add_argument("arg", nargs="?",
                       help="位置参数（含义随 program 变：角色名/章节号/幕名/assemble role/semantic-search 查询）")
    p_ctx.add_argument("--name", help="character-card 用的角色名")
    p_ctx.add_argument("--chapter", "-c", help="chapter-weave/art/previous-chapter/act/assemble 用的章节号")
    p_ctx.add_argument("--act", help="style-act 用的幕名（act-1/act-2/act-3/act-prologue/act-epilogue）")
    p_ctx.add_argument("--role", choices=["writer", "editor", "consistency"], help="assemble 用的角色")
    p_ctx.add_argument("--query", help="semantic-search 用的查询语句（也可作位置参数）")
    p_ctx.add_argument("--top-k", type=int, default=8, help="semantic-search 命中数（默认 8）")
    p_ctx.add_argument("--collection", choices=["chapters", "notes", "sources"],
                       help="semantic-search 限定 collection")
    p_ctx.set_defaults(func=cmd_ctx)

    # vector（RAG / 跨章节语义检索）
    p_vec = sub.add_parser("vector", help="向量检索管理（zvec + embedding）")
    p_vec.add_argument("vec_cmd",
                       choices=["index-chapter", "index-notes", "index-source", "index-all",
                                "search", "status", "clear"],
                       help="子操作")
    p_vec.add_argument("--chapter", "-c", help="index-chapter 用的章节号")
    p_vec.add_argument("--slug", help="index-source 用的源文本 slug（不带 .md）")
    p_vec.add_argument("--force", action="store_true", help="强制重建（删除旧条目后重新索引）")
    p_vec.add_argument("--query", help="search 用的查询语句")
    p_vec.add_argument("--top-k", type=int, default=8, help="search 命中数（默认 8）")
    p_vec.add_argument("--collection", choices=["chapters", "notes", "sources"],
                       help="search/clear 限定 collection")
    p_vec.add_argument("--yes", action="store_true", help="clear 不加确认（用于批量脚本）")
    p_vec.set_defaults(func=cmd_vector)

    # entity（动态写作空间 — 实体管理）
    _entity_collections = list(ESchema.ENTITY_COLLECTIONS) if _ENTITY_OK else [
        "characters", "locations", "items", "events",
        "foreshadowing", "easter_eggs", "storylines", "timeline",
    ]
    p_ent = sub.add_parser("entity", help="动态写作空间 — 实体管理（characters/locations/items/events/foreshadowing/...）")
    p_ent.add_argument("entity_cmd",
                       choices=["index-all", "index", "status", "list", "get",
                                "search", "update", "clear", "outline-hints"],
                       help="子操作")
    p_ent.add_argument("collection", nargs="?",
                       choices=_entity_collections,
                       help="entity collection 名")
    p_ent.add_argument("entity_id", nargs="?", help="entity get/update 用的实体 ID")
    p_ent.add_argument("--state", help="list/update/search 用的状态过滤")
    p_ent.add_argument("--state-ch", help="update 用的状态生效章节号")
    p_ent.add_argument("--text", help="update 用的新文本")
    p_ent.add_argument("--fields", nargs="*", help="update 用的额外字段（key=value 格式）")
    p_ent.add_argument("--query", help="search 用的查询语句")
    p_ent.add_argument("--top-k", type=int, default=8, help="search 命中数（默认 8）")
    p_ent.add_argument("--chapter", "-c", help="outline-hints 用的章节号")
    p_ent.add_argument("--yes", action="store_true", help="clear 不加确认")
    p_ent.set_defaults(func=cmd_entity)

    # verdict
    p_v = sub.add_parser("verdict", help="解析审核/校验报告")
    p_v.add_argument("kind", choices=["review", "consistency"], help="报告类型")
    p_v.add_argument("file", help="报告文件路径")
    p_v.set_defaults(func=cmd_verdict)

    # export
    p_e = sub.add_parser("export", help="导出整本小说")
    p_e.add_argument("format", choices=["md", "txt"], help="导出格式")
    p_e.set_defaults(func=cmd_export)

    # lint
    p_l = sub.add_parser("lint", help="项目结构校验")
    p_l.set_defaults(func=cmd_lint)

    # notes
    p_notes = sub.add_parser("notes", help="用户笔记管理（追加/浏览/标记/回滚）")
    p_notes.add_argument("sub", choices=["add", "list", "show", "link", "revert"], help="子操作")
    p_notes.add_argument("id", nargs="?", help="show/link/revert 用的笔记 ID（如 N001）")
    p_notes.add_argument("--text", help="add 用的笔记文本（verbatim）")
    p_notes.add_argument("--source", help="add 用的来源标识（如 用户修改指令 / 用户偏好陈述）")
    p_notes.add_argument("--stage", help="add 用的阶段 key（如 chapters）")
    p_notes.add_argument("--chapter", help="add 用的章节号（如 5）")
    p_notes.add_argument("--status", choices=["pending", "summarized", "reverted", "all"],
                         help="list 用的状态过滤")
    p_notes.add_argument("--to", help="link 用的目标位置（格式: file.md#section）")
    p_notes.set_defaults(func=cmd_notes)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
